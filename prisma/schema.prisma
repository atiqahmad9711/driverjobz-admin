  salaryRangeMax Decimal? @map("salary_range_max") @db.Decimal(18, 4)

  // Fields for Combination / Other
  combinationDescription String? @map("combination_description") // Describe structure, e.g., "CPM + Hourly for detention..."

  // Common fields
  minimumGuaranteedPay          Decimal? @map("minimum_guaranteed_pay") @db.Decimal(18, 4)
  minimumGuaranteedPayPeriod    Int?     @map("minimum_guaranteed_pay_period")
  minimumGuaranteedPayCondition String?  @map("minimum_guaranteed_pay_condition")
  mileageReimbursement          Decimal? @map("mileage_reimbursement") @db.Decimal(18, 4)
  mileageReimbursementUnit      Int?     @map("mileage_reimbursement_unit")
  averageEarningsEstimate       String?  @map("average_earnings_estimate") // e.g., "$1,500 - $1,800 per week"
  paySchedule                   Int?     @map("pay_schedule")

  // Sign-on bonus
  signOnBonusOffered         Boolean? @default(false) @map("sign_on_bonus_offered")
  signOnBonusAmount          Decimal? @map("sign_on_bonus_amount") @db.Decimal(18, 4)
  signOnBonusPayoutStructure String?  @map("sign_on_bonus_payout_structure") // e.g., "$1000 after 30 days..."

  // Other bonuses/compensation
  safetyBonus             Boolean @default(false) @map("safety_bonus")
  performanceBonus        Boolean @default(false) @map("performance_bonus")
  performanceBonusDetails String? @map("performance_bonus_details") // e.g., "Fuel Efficiency, On-Time"
  referralBonus           Boolean @default(false) @map("referral_bonus")
  attendanceBonus         Boolean @default(false) @map("attendance_bonus")

  detentionPay        Boolean? @map("detention_pay")
  detentionPayRate    Decimal? @map("detention_pay_rate") @db.Decimal(18, 4)
  detentionAfterHours Int?     @map("detention_after_hours")
  layoverPay          Decimal? @map("layover_pay") @db.Decimal(18, 4)

  stopPay                 Boolean? @map("stop_pay")
  stopPayPerStop          Decimal? @map("stop_pay_per_stop") @db.Decimal(18, 4)
  stopPayExcludeFirstLast Boolean? @default(false) @map("stop_pay_exclude_first_last")
  tarpingPay              Boolean? @map("tarping_pay")
  loadingUnloadingPay     Boolean? @map("loading_unloading_pay")
  nycPayDifferential      Boolean? @map("nyc_pay_differential")
  borderCrossingPay       Boolean? @map("border_crossing_pay")
  perDiem                 Boolean? @map("per_diem")
  holidayPay              Boolean? @map("holiday_pay")
  otherBonusDescription   String?  @map("other_bonus_description")
  earningEstimate         String?  @map("earning_estimate")
  benefitsPackage         Boolean? @default(false) @map("benefits_package")
  paidOrientation         Boolean? @default(false) @map("paid_orientation")

  // Benefits fields
  benefits String[] @map("benefits")

  // Driver perks and programs
  driverPerksAndPrograms String[] @map("driver_perks_and_programs")

  // Orientation information
  orientationRequired     Boolean  @default(false) @map("orientation_required")
  orientationDuration     Int?     @map("orientation_duration") // number of units
  orientationDurationUnit Int?     @map("orientation_duration_unit") // HOURS or DAYS
  orientationLocation     String?  @map("orientation_location") // e.g., "Online, Dallas TX Terminal"
  orientationExpense      Int[]    @map("orientation_expose")
  orientationPayRate      Decimal? @map("orientation_pay_rate") @db.Decimal(10, 4)
  orientationPayUnit      Int?     @map("orientation_pay_unit")

  payPerRoute             Decimal? @map("pay_per_route")
  specifyRouteDefinition  String?  @map("specify_route_definition")
  hasPayForNonDrivingTime Boolean? @default(false) @map("has_pay_for_non_driving_time")
  payForNonDrivingTime    String[] @map("pay_for_non_driving_time")
  hasBonusesOffered       Boolean? @default(false) @map("has_bonuses_offered")
  bonusesOffered          String[] @map("bonuses_offered")
  isTrainingProgram       Boolean? @map("is_training_program")
  trainingPrograms        String[] @map("training_programs")

  hasReimbursements Boolean? @default(false) @map("has_reimbursements")
  reimbursements    String[] @map("reimbursements")

  // Pay per trip fields
  payPerTrip                     Int?    @map("pay_per_trip")
  payPerTripMin                  Int?    @map("pay_per_trip_min")
  payPerTripMax                  Int?    @map("pay_per_trip_max")
  payPerTripAdditionalPayFactors String? @map("pay_per_trip_additional_pay_factors")

  benefitsEligibility Int? @map("benefits_eligibility")
  probationPeriod     Int? @map("probation_period")

  // only if rate range
  rateRangeDetails String?  @map("rate_range_details")
  startingRPM      Decimal? @map("starting_rpm") @db.Decimal(18, 4)
  startingRPMFrom  Decimal? @map("starting_rpm_from") @db.Decimal(18, 4)
  startingRPMTo    Decimal? @map("starting_rpm_to") @db.Decimal(18, 4)
  // only if Per Delivery
  payPerDelivery   Decimal? @map("pay_per_delivery") @db.Decimal(18, 4)

  // Only if PAID_LOADED_MILES
  hasPaidLoadedMiles Boolean? @default(false) @map("has_paid_loaded_miles")

  // only if Per Block/Shift
  payPerBlock           Decimal? @map("pay_per_block") @db.Decimal(18, 4)
  typicalBlockLength    String?  @map("typical_block_length")
  // only if BASE + TIPS
  basePayRate           Decimal? @map("base_pay_rate") @db.Decimal(18, 4)
  basePayRateUnit       String?  @map("base_pay_rate_unit")
  hasKeepTipsEarned     Boolean? @default(false) @map("has_keep_tips_earned")
  estimatedAvgTips      Decimal? @map("estimated_avg_tips") @db.Decimal(18, 4)
  // only if Base + Commission
  commissionStructure   String?  @map("commission_structure")
  fuelSurcharge         Int?     @map("fuel_surcharge")
  accessorialPayOffered Int[]    @map("accessorial_pay_offered")

  // Settlements & Deductions
  settlementSchedule                     Int?     @map("settlement_schedule")
  settlementPaymentMethod                Int?     @map("settlement_payment_method")
  hasSettlementQuickPayOption            Boolean? @default(false) @map("has_settlement_quick_pay_option")
  settlementQuickPayTerms                String?  @map("settlement_quick_pay_terms")
  settlementTypicalRequired              Int[]    @map("settlement_typical_required")
  otherSettlementTypicalRequired         String?  @map("other_settlement_typical_required")
  contractorExpenseResponsibilities      Int[]    @map("contractor_expense_responsibilities")
  otherContractorExpenseResponsibilities String?  @map("other_contractor_expense_responsibilities")
  securityDepositDetails                 String?  @map("security_deposit_details")

  // New fields added for heavy equipment operator
  perDiemRate                               Decimal? @map("per_diem_rate") @db.Decimal(18, 4)
  otherCompensations                        String?  @map("other_compensations")
  projectCompletionBonus                    Boolean  @default(false) @map("project_completion_bonus")
  performanceProductionBonus                Boolean  @default(false) @map("performance_production_bonus")
  // New fields for transit bus driver
  payProgressionInfo                        String?  @map("pay_progression_info")
  shiftDifferentialOffers                   String[] @map("shift_differential_offers")
  longevityPayAndServiceAwards              Boolean  @default(false) @map("longevity_pay_and_service_awards")
  cdlTrainingLicenseRenewalReimbursement    Boolean  @default(false) @map("cdl_training_license_renewal_reimbursement")
  payForReportingEarlyPreTripTime           Boolean  @default(false) @map("pay_for_reporting_early_pre_trip_time")
  isPaidTraining                            Boolean  @default(false) @map("is_paid_training")
  trainingDurationUnit                      Int?     @map("training_duration_unit")
  trainingPayRate                           Decimal? @map("training_pay_rate") @db.Decimal(18, 4)
  trainingPayUnit                           Int?     @map("training_pay_unit")
  // New fields for Dispatcher
  profitBonus                               Boolean  @default(false) @map("profit_bonus")
  // New fields for NEMT Driver
  blockImpliedHourlyRate                    Decimal? @map("block_implied_hourly_rate") @db.Decimal(18, 4)
  volunteerStipendRate                      Decimal? @map("volunteer_stipend_rate") @db.Decimal(18, 4)
  volunteerStipendUnit                      Int?     @map("volunteer_stipend_unit")
  longevityPayTenureBonus                   Boolean  @default(false) @map("longevity_pay_tenure_bonus")
  callbackOvertimePayRateBonus              Boolean  @default(false) @map("callback_overtime_pay_rate_bonus")
  // New fields for ride Share Driver
  driverPercentage                          Decimal? @map("driver_percentage") @db.Decimal(5, 2)
  perRideRate                               Decimal? @map("per_ride_rate") @db.Decimal(18, 4)
  tips                                      Int?     @map("tips")
  tipsPoolingDetails                        String?  @map("tips_pooling_details")
  newDriverSignUpBonusOffered               Boolean  @default(false) @map("new_driver_sign_up_bonus_offered")
  newDriverSignUpBonusDetails               String?  @map("new_driver_sign_up_bonus_details")
  surgePrimeTimePeakPricingMultipliersBonus Boolean  @default(false) @map("surge_prime_time_peak_pricing_multipliers_bonus")
  questConsecutiveTripBonus                 Boolean  @default(false) @map("quest_consecutive_trip_bonus")
  newDriverSignUpBonus                      Boolean  @default(false) @map("new_driver_sign_up_bonus")
  highRatingBonus                           Boolean  @default(false) @map("high_rating_bonus")
  acceptanceCompletionRateBonus             Boolean  @default(false) @map("acceptance_completion_rate_bonus")
  weeklyMonthlyPerformanceBonus             Boolean  @default(false) @map("weekly_monthly_performance_bonus")
  tollReimbursementsBonus                   Boolean  @default(false) @map("toll_reimbursements_bonus")
  fuelSurchargeAssistanceBonus              Boolean  @default(false) @map("fuel_surcharge_assistance_bonus")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [jobPostingId])
}

model PreHirePackage {
  preHirePackageId Int                  @id @default(autoincrement()) @map("pre_hire_package_id")
  userId           Int                  @map("user_id")
  companyId        Int                  @map("company_id")
  status           PreHirePackageStatus @map("status")
  otpVerifiedAt    DateTime?            @map("otp_verified_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")
  isActive         Boolean              @default(true) @map("isactive")
  user             User                 @relation(fields: [userId], references: [userId], onDelete: Cascade)
  company          Company              @relation(fields: [companyId], references: [companyId])
}

model FlagDriver {
  flagDriverId Int        @id @default(autoincrement()) @map("flag_driver_id")
  driverId     Int        @map("driver_id")
  userId       Int        @map("user_id")
  status       FlagStatus @default(PENDING) @map("status")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  driver       Driver     @relation(fields: [driverId], references: [driverId])
  user         User       @relation(fields: [userId], references: [userId])

  @@unique([driverId, userId])
}

model FlagJobPost {
  flagJobId    Int        @id @default(autoincrement()) @map("flag_job_id")
  jobPostingId Int        @map("job_posting_id")
  userId       Int        @map("user_id")
  status       FlagStatus @default(PENDING) @map("status")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [jobPostingId])
  user         User       @relation(fields: [userId], references: [userId])

  @@unique([jobPostingId, userId])
}

enum FlagStatus {
  PENDING
  ACCEPTED
  IGNORE
}

enum CertificateType {
  BUS_DRIVER
  OTHER
}

enum ProfileStatus {
